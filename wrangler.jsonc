{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "portfolio",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NOTION_DATABASE_ID": "3dbdf2e0-0adf-40de-8a24-2369fef50469",
    "R2_ACCOUNT_ID": "d5cfddb3193f9878ca6ecbfb980de515",
    "R2_BUCKET_NAME": "mchkn-blog-images",
    "R2_PUBLIC_URL": "https://images.mchkn.com",
    "NEXT_PUBLIC_R2_PUBLIC_URL": "https://images.mchkn.com"
  }
}
