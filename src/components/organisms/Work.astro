---
import { getCollection } from 'astro:content';
import SectionLabel from '../atoms/SectionLabel.astro';
import WorkCard from '../molecules/WorkCard.astro';

let works: Awaited<ReturnType<typeof getCollection<'works'>>> = [];
let loadError = false;

try {
	works = (await getCollection('works')).sort(
		(a, b) => a.data.order - b.data.order,
	);
} catch {
	loadError = true;
}
---

<section id="work" class="work">
	<div class="work__inner">
		<SectionLabel text="WORKS" />
		{
			loadError || works.length === 0 ? (
				<p class="work__lead reveal">Cannot fetch Work informations.</p>
			) : (
				<div class="work__grid">
					{works.map((entry, index) => (
						<WorkCard work={entry.data} index={index} />
					))}
				</div>
			)
		}
	</div>
</section>
