---
import { formatDate, type Post } from '../../lib/blog';

interface Props {
	post: Post;
	categoryLabel: string;
	index: number;
}

const { post, categoryLabel, index } = Astro.props;
---

<article class="post-card reveal" style={`transition-delay: ${index * 80}ms`}>
	<div class="post-card__meta">
		<time datetime={post.data.publishedAt.toISOString()}>
			{formatDate(post.data.publishedAt)}
		</time>
		<span class="post-card__category">{categoryLabel}</span>
	</div>
	<h3 class="post-card__title">
		<a href={`/blog/${post.id}`} class="post-card__link">{post.data.title}</a>
	</h3>
	{
		post.data.description && (
			<p class="post-card__desc">{post.data.description}</p>
		)
	}
</article>
