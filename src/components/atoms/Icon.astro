---
import { icons, type IconName } from '../../data/icons';

interface Props {
	name: IconName;
}

const { name } = Astro.props;
const icon = icons[name];
---

{
	icon.mode === 'stroke' ? (
		<svg
			class="icon"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.8"
			set:html={icon.markup}
		/>
	) : (
		<svg
			class="icon"
			viewBox="0 0 24 24"
			fill="currentColor"
			set:html={icon.markup}
		/>
	)
}
