{
  "name": "src",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .dev.vars -- next dev",
    "build": "dotenv -e .dev.vars -- next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run lint && npm run format:check && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@notionhq/client": "^2.3.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@smithy/fetch-http-handler": "^5.7.0",
    "next": "16.3.0",
    "notion-compat": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-notion-x": "^7.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.121.0"
  }
}
